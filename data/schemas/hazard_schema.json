{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CivicPulseHazard",
  "description": "Geospatial civic hazard data model for Madurai Spatial Lakehouse",
  "type": "object",
  "required": [
    "hazard_id",
    "location_name",
    "hazard_type",
    "severity",
    "status",
    "geometry",
    "longitude",
    "latitude",
    "observed_at",
    "updated_at",
    "source_type",
    "confidence",
    "created_at"
  ],
  "properties": {
    "hazard_id": {
      "type": "string",
      "pattern": "^HAZ-[A-Z0-9-]+$"
    },
    "location_name": {
      "type": "string"
    },
    "hazard_type": {
      "type": "string",
      "enum": ["FLOOD", "WASTE_OVERFLOW", "DEBRIS", "ROAD_DAMAGE"]
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "MODERATE", "LOW"]
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "INVESTIGATING", "RESOLVED"]
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon"]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "water_depth_cm": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string",
      "enum": ["CITIZEN_REPORT", "IOT_SENSOR", "MUNICIPAL_WARD_OFFICER", "SATELLITE_RADAR", "SIMULATED"]
    },
    "source_reference": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "simulation_id": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
