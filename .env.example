# ==============================================================================
# CivicPulse — Madurai Spatial Lakehouse Environment Configuration
# ==============================================================================

APP_ENV=development
# "demo" for reproducible local evaluation or "live" for real AWS calls
APP_MODE=demo
DEBUG=true

# AWS Deployment Region
AWS_REGION=ap-south-1

# Amazon S3 & Lakehouse Storage
AWS_S3_BUCKET=civicpulse-madurai-lakehouse
AWS_S3_DATA_PREFIX=civicpulse/
AWS_ATHENA_DATABASE=civicpulse_db
AWS_ATHENA_TABLE=civic_hazards_iceberg
AWS_ATHENA_WORKGROUP=primary
AWS_ATHENA_RESULTS_S3_URI=s3://civicpulse-madurai-lakehouse/civicpulse/query-results/

# Amazon Location Service Resources
AWS_LOCATION_MAP_NAME=CivicPulseMaduraiMap
AWS_LOCATION_PLACE_INDEX=CivicPulseMaduraiPlaces
AWS_LOCATION_ROUTE_CALCULATOR=CivicPulseMaduraiRoutes
AWS_LOCATION_GEOFENCE_COLLECTION=CivicPulseMaduraiGeofences
AWS_LOCATION_TRACKER_NAME=CivicPulseMaduraiTracker

# Optional Amazon Location API Key for browser-side direct tiles (if used)
AWS_LOCATION_API_KEY=

# Ports & Hosts
FRONTEND_PORT=5173
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
